APP_NAME=Sportvatar
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://sportvatar.com
APP_LOCALE=en

LOG_CHANNEL=daily
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sportvatar
DB_USERNAME=sportvatar
DB_PASSWORD=

# Redis is shared with other sites on the same server: keep a unique prefix and DB numbers
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX=sportvatar_reboot_
REDIS_DB=2
REDIS_CACHE_DB=3
REDIS_QUEUE_RETRY_AFTER=3700

CACHE_DRIVER=redis
CACHE_PREFIX=sportvatar_reboot
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

MAIL_MAILER=log
FILESYSTEM_DISK=local

# images.sportvatar.com bucket (R2/S3); only needed when SPORTVATAR_IMAGE_EXPORT_ENABLED=true
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=

# Flow
FLOW_NETWORK=mainnet
FLOW_MARKET_ADDRESS=0xca5c31c0c03e11be
FLOW_SIGNER=mainnet-account
# Directory of the flow binary (absolute path, ~ is not expanded)
FLOW_PATH=/home/forge/.local/bin
FLOW_TIMEOUT=120
FLOW_MIN_BLOCK_HEIGHT=

# Built-in Flow event indexer (flow:stream daemon + flow:catchup every 5 min + flow:process)
FLOW_REST_URL=https://rest-mainnet.onflow.org
FLOW_WS_URL=wss://rest-mainnet.onflow.org/v1/ws
FLOW_INDEXER_ENABLED=true
FLOW_INDEXER_START_HEIGHT=
FLOW_INDEXER_RPS=20
FLOW_INDEXER_MAX_BLOCKS=25000

# Graffle is dead since the Crescendo spork (2024-09); /graffle only exists when true
GRAFFLE_WEBHOOK_ENABLED=false
GRAFFLE_WEBHOOK_SECRET=

# Front end (baked into public/js/app.js by `npm run production`)
MIX_ACCESS_NODE=https://rest-mainnet.onflow.org
# Dapper only today. To open the site to Flow Wallet later, switch to FCL discovery
# (https://fcl-discovery.onflow.org/authn) and add the wallet to SPORTVATAR_WALLETS.
MIX_WALLET_DISCOVERY=https://accounts.meetdapper.com/fcl/authn-restricted
MIX_CONTRACT_FLOW=0xca5c31c0c03e11be
MIX_CONTRACT_FUNGIBLE=0xf233dcee88fe0abe
MIX_CONTRACT_NON_FUNGIBLE=0x1d7e57aa55817448
MIX_CONTRACT_FLOW_TOKEN=0x1654653399040a61
MIX_CONTRACT_DUC=0xead892083b3e2c6c
MIX_CONTRACT_FIND=0x097bafa4e0b48eef
MIX_CONTRACT_PROFILE=0x097bafa4e0b48eef
MIX_CONTRACT_STOREFRONT2=0x4eb8a10cb9f87357
MIX_DAPPER_MERCHANT=0x8a86f18e0e05bd9f
MIX_METADATA_VIEWS=0x1d7e57aa55817448
MIX_PUSHER_APP_KEY=
MIX_PUSHER_APP_CLUSTER=

# Feature flags
SPORTVATAR_LIVE=true
SPORTVATAR_INTERNAL=false
SPORTVATAR_PACK_LIVE=false
PACK_SALE_ENABLED=false
SPORTVATAR_WALLETS=dapper
# Relaunch: pack sales and free-pack claims stay off until the contract updates are signed and
# pack codes v2 are live (answers with SPORTVATAR_PACK_SALES_NOTICE)
SPORTVATAR_PACK_SALES_ENABLED=false
SPORTVATAR_PACK_CLAIMS_ENABLED=false
SPORTVATAR_PACK_SALES_NOTICE=
# Images: serve exports from the CDN; re-rendering (webgif/Chromium/ffmpeg) is off
SPORTVATAR_IMAGES_URL=https://images.sportvatar.com/sportvatar
SPORTVATAR_IMAGE_PROXY=redirect
SPORTVATAR_IMAGE_EXPORT_ENABLED=false
SPORTVATAR_RENDER_BASE_URL=
# Incident 2026-11-16 (comma separated)
SPORTVATAR_BLOCKED_ADDRESSES=0x0c7deb7a0c9cb424

# Wallet login (FCL account-proof): comma separated origins accepted as appIdentifier.
# Default: the origin of APP_URL. Add www/staging origins if the site is served there.
SPORTVATAR_ACCOUNT_PROOF_ORIGINS=https://sportvatar.com

# Filament admin (/admin): wallet addresses allowed in (comma separated); log in with the wallet first
ADMIN_ADDRESSES=

# Paid pack reservations expire after this many minutes (also used by sportvatar:clean-packs)
PACK_RESERVATION_MINUTES=60

# Pack codes v2 (see docs/PACK-CODES-V2.md)
PACK_SIGNER_KEY_PATH=
PACK_EPOCH=1
PACK_AUTH_TTL=900
PACK_CODE_PEPPER=

# Newsletter (Sender.net) and RCS identity forwarding (off by default)
SENDER_MAIL_TOKEN=
RCS_APP_ID=
RCS_PROVIDER_ID=
RCS_REGISTRATION_ENABLED=false

# Optional integrations
QUEUEIT_ID=
QUEUEIT_SECRET=
QUEUEIT_API_KEY=
TWITTER_CONSUMER_KEY=
TWITTER_CONSUMER_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
